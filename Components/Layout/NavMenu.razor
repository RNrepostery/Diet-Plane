@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="d-flex flex-column h-100 bg-dark text-white p-3 shadow-lg" style="background: #0f172a !important;">
    <!-- App Brand -->
    <div class="d-flex align-items-center gap-3 px-2 py-3 mb-3 border-bottom border-secondary">
        <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);">
            <i class="bi bi-heart-pulse-fill fs-4"></i>
        </div>
        <div>
            <h6 class="fw-bold mb-0 text-white">Clinical Dietetics</h6>
            <small class="fs-7" style="color: #2dd4bf;">Diet & Nutrition System</small>
        </div>
    </div>

    <!-- Nav Items -->
    <nav class="nav nav-pills flex-column gap-2 mb-auto">
        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="" Match="NavLinkMatch.All">
            <i class="bi bi-grid-1x2-fill fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Dashboard</span>
        </NavLink>

        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="patient-intake">
            <i class="bi bi-person-plus-fill fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Patient Intake</span>
        </NavLink>

        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="disease-master">
            <i class="bi bi-shield-shaded fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Disease Master</span>
        </NavLink>

        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="master-items">
            <i class="bi bi-database-fill-gear fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Item Master (Foods)</span>
        </NavLink>

        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="diet-plan-generator">
            <i class="bi bi-journal-medical fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Diet Plan Generator</span>
        </NavLink>

        <NavLink class="nav-link text-light d-flex align-items-center gap-3 py-2.5 px-3 rounded-3" href="diet-plans">
            <i class="bi bi-file-earmark-medical-fill fs-5" style="color: #2dd4bf;"></i>
            <span class="fw-semibold">Saved Diet Charts</span>
        </NavLink>
    </nav>

    <!-- User Profile & Logout -->
    <div class="mt-auto pt-3 border-top border-secondary">
        <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background: rgba(255,255,255,0.06);">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 34px; height: 34px; background: #0d9488;">
                    A
                </div>
                <div>
                    <div class="fw-bold fs-7 text-white">@AuthService.CurrentUsername</div>
                    <span class="badge" style="background-color: #0d9488; font-size: 0.7rem;">Dietitian / Admin</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-danger border-0 text-white-50" title="Logout" @onclick="Logout">
                <i class="bi bi-box-arrow-right fs-5"></i>
            </button>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}
