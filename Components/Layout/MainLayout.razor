@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

@if (!AuthService.IsAuthenticated && !IsLoginPage)
{
    <Login />
}
else
{
    <div class="d-flex flex-column flex-md-row min-vh-100">
        <!-- Desktop Sidebar -->
        <div class="d-none d-md-block shadow" style="width: 280px; flex-shrink: 0; min-height: 100vh;">
            <NavMenu />
        </div>

        <!-- Mobile Header Bar -->
        <div class="d-md-none top-navbar d-flex align-items-center justify-content-between p-3 sticky-top">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-heart-pulse-fill text-info fs-4"></i>
                <span class="fw-bold text-white fs-6">Dietetics Admin</span>
            </div>
            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
                <i class="bi bi-list fs-4"></i>
            </button>
        </div>

        <!-- Mobile Offcanvas Menu -->
        <div class="offcanvas offcanvas-start bg-dark p-0" tabindex="-1" id="mobileMenu" style="width: 280px;">
            <div class="offcanvas-header border-bottom border-secondary text-white">
                <h6 class="offcanvas-title fw-bold">Menu Navigation</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0 h-100">
                <NavMenu />
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column min-vh-100 bg-light">
            <header class="bg-white border-bottom px-4 py-3 d-none d-md-flex align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center gap-2 text-secondary">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <span class="small fw-semibold">Authenticated Admin Session: <strong>Ashish</strong></span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMM yyyy")</span>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </div>
            </header>

            <main class="p-3 p-md-4 flex-grow-1">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool IsLoginPage => Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}
