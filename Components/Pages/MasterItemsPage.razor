@page "/master-items"
@inject DataService DataService

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-database-fill-gear text-teal me-2" style="color: #0d9488;"></i>
                Food Item Master Database
            </h3>
            <p class="text-secondary small mb-0">Define food items with macronutrients per 1 gram (1g C/P = 4 kcal, 1g Fat = 9 kcal) and map contraindicated diseases.</p>
        </div>
        <button class="btn btn-emerald rounded-pill px-4 shadow-sm" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg me-1"></i> Add Food Item
        </button>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card card-custom p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control" placeholder="Search food by name or notes..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedCategory">
                    <option value="All">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="selectedDietCategory">
                    <option value="All">All Diets</option>
                    <option value="Vegetarian">Vegetarian</option>
                    <option value="Non-Veg">Non-Veg</option>
                    <option value="Vegan">Vegan</option>
                    <option value="Eggitarian">Eggitarian</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="selectedDiseaseFilter">
                    <option value="All">All Restrictions</option>
                    @foreach (var d in diseases)
                    {
                        <option value="@d.Name">Restricted in @d.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Food Master Table -->
    <div class="card card-custom p-4">
        @if (!FilteredItems.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-basket3 display-4 text-muted mb-2"></i>
                <h5 class="text-secondary">No food items found matching criteria.</h5>
                <p class="text-muted small">Add items to the master database to use them in clinical calculations and diet plan generation.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Food Item</th>
                            <th>Category</th>
                            <th>Macros per 1 Gram</th>
                            <th>Standard Portion</th>
                            <th>Serving Energy</th>
                            <th>Disease Restrictions</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="d-flex align-items-center gap-1 mt-1">
                                        <span class="badge @GetDietBadgeClass(item.DietCategory)">@item.DietCategory</span>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <span class="text-muted fs-8 text-truncate" style="max-width: 200px;" title="@item.Notes">@item.Notes</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Category</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="text-warning-emphasis fw-bold">C: @item.CarbsPerGram g/g</span> |
                                        <span class="text-primary fw-bold">P: @item.ProteinPerGram g/g</span> |
                                        <span class="text-secondary fw-bold">F: @item.FatPerGram g/g</span>
                                    </div>
                                    <small class="text-muted fs-8 font-monospace">@item.CaloriesPerGram kcal/g</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@item.ServingQuantity @item.StandardUnit</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-danger">@item.Calories kcal</div>
                                    <small class="text-muted d-block fs-8">P: @item.Protein g | C: @item.Carbs g | F: @item.Fat g</small>
                                </td>
                                <td>
                                    @if (item.ContraindicatedDiseases.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                                            @foreach (var dis in item.ContraindicatedDiseases)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-8">
                                                    <i class="bi bi-x-circle me-1"></i>@dis
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-8">
                                            <i class="bi bi-check-circle me-1"></i>No Restrictions
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditItem(item)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item.Id)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Form for Adding / Editing Master Item -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content rounded-4 shadow border-0">
                <div class="modal-header card-header-emerald text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>
                        @(string.IsNullOrEmpty(editItem.Id) || editItem.Id == "0" ? "Add New Clinical Food Item" : "Edit Master Food Item")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label required">Food Item Name</label>
                            <input type="text" class="form-control" placeholder="e.g. Rolled Oats" @bind="editItem.Name" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" @bind="editItem.Category">
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Diet Category</label>
                            <select class="form-select" @bind="editItem.DietCategory">
                                <option value="Vegetarian">Vegetarian</option>
                                <option value="Non-Veg">Non-Veg</option>
                                <option value="Vegan">Vegan</option>
                                <option value="Eggitarian">Eggitarian</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Standard Portion Quantity</label>
                            <input type="number" step="1" class="form-control" @bind="editItem.ServingQuantity" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Standard Portion Unit</label>
                            <input type="text" class="form-control" placeholder="g, ml, piece, roti, bowl" @bind="editItem.StandardUnit" />
                        </div>

                        <!-- Macronutrients per 1 Gram -->
                        <div class="col-12 border-top pt-3 mt-3">
                            <h6 class="fw-bold text-teal mb-2" style="color: #0d9488;">
                                <i class="bi bi-speedometer2 me-1"></i> Clinical Macronutrients per 1 Gram (g / g)
                            </h6>
                            <p class="text-secondary small mb-3">Energy formula: 1g Carb = 4 kcal | 1g Protein = 4 kcal | 1g Fat = 9 kcal. Energy per gram is calculated automatically.</p>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold text-warning-emphasis">Carbs (g/g)</label>
                            <input type="number" step="0.001" min="0" max="1" class="form-control" @bind="editItem.CarbsPerGram" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold text-primary">Protein (g/g)</label>
                            <input type="number" step="0.001" min="0" max="1" class="form-control" @bind="editItem.ProteinPerGram" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold text-secondary">Fats (g/g)</label>
                            <input type="number" step="0.001" min="0" max="1" class="form-control" @bind="editItem.FatPerGram" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold text-success">Fiber (g/g)</label>
                            <input type="number" step="0.001" min="0" max="1" class="form-control" @bind="editItem.FiberPerGram" />
                        </div>

                        <!-- Live Calculated Energy Banner -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <small class="text-muted d-block font-monospace">AUTOMATED ENERGY DENSITY</small>
                                    <strong class="text-dark fs-5">@editItem.CaloriesPerGram kcal per 1g</strong>
                                </div>
                                <div class="text-md-end">
                                    <small class="text-muted d-block font-monospace">PER STANDARD PORTION (@editItem.ServingQuantity @editItem.StandardUnit)</small>
                                    <span class="badge bg-danger fs-6">@editItem.Calories kcal</span>
                                    <span class="badge bg-primary fs-6">P: @editItem.Protein g</span>
                                    <span class="badge bg-warning text-dark fs-6">C: @editItem.Carbs g</span>
                                    <span class="badge bg-secondary fs-6">F: @editItem.Fat g</span>
                                </div>
                            </div>
                        </div>

                        <!-- Disease Restrictions Mapping -->
                        <div class="col-12 border-top pt-3 mt-3">
                            <h6 class="fw-bold text-danger mb-2">
                                <i class="bi bi-shield-x me-1"></i> Disease Restrictions Mapping (Contraindications)
                            </h6>
                            <p class="text-secondary small mb-2">Select clinical diagnoses for which this food item is strictly contraindicated (will be auto-filtered out during diet plan generation):</p>
                            
                            <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" style="max-height: 180px; overflow-y: auto;">
                                @foreach (var dis in diseases)
                                {
                                    <div class="form-check me-3">
                                        <input class="form-check-input" type="checkbox" id="modal-dis-@dis.Id"
                                               checked="@editItem.ContraindicatedDiseases.Contains(dis.Name)"
                                               @onchange="(e) => ToggleDiseaseRestriction(dis.Name, e.Value)" />
                                        <label class="form-check-label small fw-semibold" for="modal-dis-@dis.Id">@dis.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Clinical Notes & Micronutrient Profile</label>
                            <textarea class="form-control" rows="2" placeholder="e.g. Low glycemic index, rich in potassium, high purine..." @bind="editItem.Notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-emerald rounded-pill px-4" @onclick="SaveMasterItem">
                        <i class="bi bi-check-lg me-1"></i> Save Food Item
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FoodItem> items = new();
    private List<Disease> diseases = new();
    private string searchTerm = string.Empty;
    private string selectedCategory = "All";
    private string selectedDietCategory = "All";
    private string selectedDiseaseFilter = "All";

    private bool showModal = false;
    private FoodItem editItem = new FoodItem();

    private readonly List<string> categories = new()
    {
        "Cereals", "Proteins", "Dairy", "Vegetables", "Fruits", "Nuts & Seeds", "Snacks", "Beverages", "Supplements"
    };

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        items = DataService.GetMasterFoodItems();
        diseases = DataService.GetDiseases();
    }

    private IEnumerable<FoodItem> FilteredItems => items.Where(i =>
        (string.IsNullOrWhiteSpace(searchTerm) || i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || i.Notes.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedCategory == "All" || i.Category == selectedCategory) &&
        (selectedDietCategory == "All" || i.DietCategory == selectedDietCategory) &&
        (selectedDiseaseFilter == "All" || i.ContraindicatedDiseases.Contains(selectedDiseaseFilter, StringComparer.OrdinalIgnoreCase))
    );

    private string GetDietBadgeClass(string diet) => diet switch
    {
        "Vegetarian" => "bg-success-subtle text-success border border-success-subtle",
        "Vegan" => "bg-teal-subtle text-teal border",
        "Non-Veg" => "bg-danger-subtle text-danger border border-danger-subtle",
        "Eggitarian" => "bg-warning-subtle text-warning-emphasis border",
        _ => "bg-secondary-subtle text-dark"
    };

    private void OpenAddModal()
    {
        editItem = new FoodItem();
        showModal = true;
    }

    private void EditItem(FoodItem item)
    {
        editItem = new FoodItem
        {
            Id = item.Id,
            Name = item.Name,
            Category = item.Category,
            StandardUnit = item.StandardUnit,
            ServingQuantity = item.ServingQuantity,
            CarbsPerGram = item.CarbsPerGram,
            ProteinPerGram = item.ProteinPerGram,
            FatPerGram = item.FatPerGram,
            FiberPerGram = item.FiberPerGram,
            DietCategory = item.DietCategory,
            ContraindicatedDiseases = new List<string>(item.ContraindicatedDiseases),
            Notes = item.Notes,
            CreatedAt = item.CreatedAt
        };
        showModal = true;
    }

    private void ToggleDiseaseRestriction(string diseaseName, object? isChecked)
    {
        bool b = isChecked is bool val && val;
        if (b && !editItem.ContraindicatedDiseases.Contains(diseaseName))
        {
            editItem.ContraindicatedDiseases.Add(diseaseName);
        }
        else if (!b)
        {
            editItem.ContraindicatedDiseases.Remove(diseaseName);
        }
    }

    private void CloseModal() => showModal = false;

    private void SaveMasterItem()
    {
        if (string.IsNullOrWhiteSpace(editItem.Name)) return;
        DataService.SaveFoodItem(editItem);
        showModal = false;
        RefreshData();
    }

    private void DeleteItem(string id)
    {
        DataService.DeleteFoodItem(id);
        RefreshData();
    }
}
