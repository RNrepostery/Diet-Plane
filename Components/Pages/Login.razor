@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center p-3" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="card card-custom shadow-lg p-4 p-md-5" style="max-width: 440px; width: 100%; border-radius: 1.25rem;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-teal-subtle rounded-circle mb-3" style="width: 70px; height: 70px; background: rgba(13, 148, 136, 0.15); color: #0d9488;">
                <i class="bi bi-heart-pulse-fill display-5"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">Clinical Dietetics</h3>
            <p class="text-secondary small mb-0">Professional Diet & Nutrition Management</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center rounded-3 p-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <small>@errorMessage</small>
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">ADMIN USERNAME</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-person-fill"></i></span>
                    <input type="text" class="form-control" placeholder="Enter username (Ashish)" @bind="loginModel.Username" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small fw-semibold">PASSWORD</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock-fill"></i></span>
                    <input type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Enter password (Ashish@2026)" @bind="loginModel.Password" required />
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-emerald w-100 py-2.5 shadow-sm fw-bold mb-3 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-in-right fs-5"></i> Login to System
            </button>
        </EditForm>

        <div class="bg-light p-3 rounded-3 text-center border">
            <small class="text-muted d-block fw-semibold mb-1">Mandatory Admin Credentials:</small>
            <div class="badge bg-secondary-subtle text-dark me-1">Username: <b>Ashish</b></div>
            <div class="badge bg-secondary-subtle text-dark">Password: <b>Ashish@2026</b></div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;
    private bool showPassword = false;

    private void TogglePassword() => showPassword = !showPassword;

    private void HandleLogin()
    {
        errorMessage = string.Empty;
        if (AuthService.Login(loginModel.Username, loginModel.Password, out string err))
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = err;
        }
    }

    private class LoginModel
    {
        public string Username { get; set; } = "Ashish";
        public string Password { get; set; } = "Ashish@2026";
    }
}
